# 内置 AI 服务密钥模板（复制为 .env 后填入，.env 已被 .gitignore 排除）
# 构建期经 --dart-define=BUILTIN_LLM_KEYS 注入；源码 / 仓库 / git 历史绝不出现明文。
# 按优先级排序；下方仅作结构示例，请替换为真实密钥。
# 每个条目：baseUrl(OpenAI 兼容 chat/completions 前缀) + model + key。
BUILTIN_LLM_KEYS='[{"baseUrl":"https://open.bigmodel.cn/api/paas/v4","model":"glm-5.3-flash","key":"<YOUR_KEY_1>"},{"baseUrl":"https://open.bigmodel.cn/api/paas/v4","model":"glm-4-flash","key":"<YOUR_KEY_2>"}]'
