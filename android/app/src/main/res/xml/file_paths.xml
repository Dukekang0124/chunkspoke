<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- 外部存储（Android/data/.../files）下的更新包（保留兼容） -->
    <external-files-path name="updates_external" path="." />
    <!-- 内部 files/updates：UpdateService 实际落盘路径（getApplicationSupportDirectory） -->
    <!-- 注意：root 名称必须唯一，否则同名 root 会互相覆盖导致 FileProvider 找不到文件 -->
    <files-path name="updates_internal" path="updates" />
    <!-- 录音分享（§拾音-分享）：Dart 侧把最近一次 WAV 复制到 cache/share/ 再分享。
         只暴露这个子目录，不开放整个 cache，避免把合成音频/下载残留一起暴露出去。 -->
    <cache-path name="asr_share" path="share" />
</paths>
